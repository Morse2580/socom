<?xml version="1.0" encoding="UTF-8"?>
<!--
  socom context envelope — fill and drop at .socom/context/<id>.xml. One envelope
  per promise execution: declare the input context this work unit consumed against
  the budget you set for it. See schemas/context.xml for the field contract, the
  budget invariant (input_tokens <= budget_tokens), and the measurement rule.

  Two ways to use it:
   - CTX-1 (declare): omit <inputs>, set input_tokens by hand, `socom context
     verify <file>`. The gate checks only declared <= budget.
   - CTX-2 (measure): list each input as an <input ref="repo/relative/path"/>, then
     `socom context measure <file>` to fill the token counts FROM the live files,
     then `socom context verify <file>`. verify RE-MEASURES the refs and fails
     unless your declared counts match — so the number cannot be faked. If you are
     over budget, `socom context compress <file>` drops the lowest-relevance inputs
     until it fits. Counts are a chars/4 estimate (a lower bound — leave headroom).

  Replace every FILL. Drop the <inputs> block for the CTX-1 declare style.
-->
<context socom="0.1"
         id="CTX-FILL-date-seq"
         promise="P-FILL"
         seat="FILL: builder|reviewer|validator|scout|…"
         ts="FILL: 2026-06-20T12:00:00Z"
         budget_tokens="FILL-int"
         input_tokens="0">
  <!-- CTX-2: list the inputs, leave tokens="0", run `socom context measure`.
       Drop this whole block for the CTX-1 declare style. -->
  <inputs>
    <input ref="FILL: repo-relative path" tokens="0"/>
  </inputs>
</context>
