l info — never verbatim into briefs</case>\n    <case>human explicitly asks for a summary brief — opted out for that spawn</case>\n  </counter-cases>\n\n  <links>\n    <link ref="M-mason-aegis-pattern"/>\n  </links>\n  <!-- supersession is explicit and preserving:\n       <superseded-by ref="M-..." date="..."/> — body is never deleted -->\n</memory>\n',
