e 1e5daed6eff70411980ca04377247f2706f37751 -- R/html.R", "exit": 0, "stdout": "100644 blob eb7ecc572da6844d6b583c871ce6dca63acd5a8c\tR/html.R", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- R/huxreg.R", "exit": 0, "stdout": "100644 blob 4d042d54b9d0a2ce735f5859c84daad56a4bea8b\tR/huxreg.R", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- R/knitr.R", "exit": 0, "stdout": "100644 blob 38917699c820bbc1f3ec23fbaea5d8fa05756607\tR/knitr.R", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- R/latex.R", "exit": 0, "stdout": "100644 blob 1cdf96e106a0e94c4c41a0cfbaca8669104b7dd1\tR/latex.R", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- R/md.R", "exit": 0, "stdout": "100644 blob 5cc6574948f92161027f209a86165b8a6da9f014\tR/md.R", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- R/merge.R", "exit": 0, "stdout": "100644 blob 692c452f12dc8de2f6161ad4bef75003d3ceac42\tR/merge.R", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- R/property-helpers.R", "exit": 0, "stdout": "100644 blob 2597b184ba1f4c1b8c02b6a62a947e968defd70c\tR/property-helpers.R", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- R/quick-functions.R", "exit": 0, "stdout": "100644 blob 343fe0335915c9b0f27835d6dd85f149b80c0c45\tR/quick-functions.R", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- R/rtf.R", "exit": 0, "stdout": "100644 blob ed1ed6bb8e6652f116d31606b20df9492c55c5c1\tR/rtf.R", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- R/subset-extract.R", "exit": 0, "stdout": "100644 blob 7d8cb25ccd3b80378c71333b4199be1ac91f8a54\tR/subset-extract.R", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- R/typst.R", "exit": 0, "stdout": "100644 blob 9caa7f8e5195f05ad04213cdb78db95dd17a2981\tR/typst.R", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- README.md", "exit": 0, "stdout": "100644 blob 8493de6e9f1a8436de17267c2998baf90968c2dc\tREADME.md", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- agent-notes.md", "exit": 0, "stdout": "100644 blob 65bd6c87b3409c62ac74b1ce94bbfcd5e120990a\tagent-notes.md", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- design.md", "exit": 0, "stdout": "100644 blob 8273111167a9382876b3cfd6aeac61920186a86d\tdesign.md", "stderr": ""}, {"cmd": "git ls-tree 1e5daed6eff70411980ca04377247f2706f37751 -- tests/testthat/", "exit": 0, "stdout": "100644 blob c109e737081df1198cfe820d0658f78be01388be\ttests/testthat/.gitignore\n040000 tree 30d2801a9e07c7f9ec43ebd031d3c25d0299a744\ttests/testthat/_snaps\n100644 blob 1a41ec52322147ce6e9fccf9222677056d221f0b\ttests/testthat/bones.png\n100644 blob 62d3843a8de478776fd6efe90f5ea3904d580cf2\ttests/testthat/bookdown-test.Rmd\n100644 blob 59e8ddb50fd5f196d58b95ce7a8b862c391176c4\ttests/testthat/echo-true-late", "stderr": ""}]}
{"id": "R1C-C02", "class": "control", "subclass": "non-vacuity", "applies_to": "R1C-C01", "repo": "hughjonesd/huxtable", "config": "CLAUDE.md", "expected": {"assertions_extracted": ">= 20"}, "claim": "R1 must extract at least 20 checkable path assertions from R1C-C01's config and report zero findings. Zero findings with fewer than 20 assertions extracted is a FAILURE, not a pass.", "why_this_is_the_killer": "an honest-config control alone cannot tell 'parsed the config and found it truthful' from 'parsed nothing at all' -- both emit zero findings. Without this assertion a parser that understands none of the file passes every clean-repo test in this corpus.", "ground_truth_referents": ["AGENTS.md", "R/bind-insert.R", "R/clean-contents.R", "R/creation-internal.R", "R/creation.R", "R/html.R", "R/huxreg.R", "R/knitr.R", "R/latex.R", "R/md.R", "R/merge.R", "R/property-helpers.R", "R/quick-functions.R", "R/rtf.R", "R/subset-extract.R", "R/typst.R", "README.md", "agent-notes.md", "design.md", "tests/testthat/"]}
{"id": "R1C-C03", "class": "control", "subclass": "no-checkable-content", "repo": "PeggyJV/sommelier-strangelove", "clone": "https://github.com/PeggyJV/sommelier-strangelove.git", "config": "CLAUDE.md", "head": "80cbec8dffc9a200d564a29dfb7f95620a39612c", "commits_at_head": "5171", "config_lines": 19, "expected": {"at_head": "NOTHING-TO-CHECK"}, "claim": "this config is pure prose -- code-review guidance with no path, command, or target referent anywhere in it. R1 must report 'nothing to check' DISTINGUISHABLY from 'checked, clean'.", "why_distinguishable_matters": "if the two collapse to the same output, a user cannot tell a healthy repo from one R1 failed to parse -- which is the same failure mode R1C-C02 exists to catch, seen from the user's side.", "confirm": [{"cmd": "git show 80cbec8dffc9:CLAUDE.md | grep -cE '`[^`]+`'", "exit": 1, "stdout": "0", "stderr": "", "note": "zero backticked spans == nothing declared"}]}
{"id": "R1C-N01", "class": "control", "subclass": "near-miss/wrapper-command", "repo": "bpg/terraform-provider-proxmox", "clone": "https://github.com/bpg/terraform-provider-proxmox.git", "config": "CLAUDE.md", "referent": "make lint", "head": "7b08decaa4f6c9123c7813ba9555ea61188031e2", "declaration": {"line": 133}, "expected": {"at_head": "CLEAN"}, "fact": "`make lint` resolves to a Makefile target (Makefile:113), not to a file named `lint`. No such file exists at HEAD.", "trap": "a detector that resolves command words against the filesystem reports 'lint not found'. R1 must resolve against Makefile targets.", "confirm": []}
{"id": "R1C-N02", "class": "control", "subclass": "near-miss/wrapper-command", "repo": "AlanSynn/alansynn.github.io", "clone": "https://github.com/AlanSynn/alansynn.github.io.git", "config": "CLAUDE.md", "referent": "just check-isolation", "head": "b71cbe6661ec1b279c581344ea60ad4d07cf0bae", "declaration": {"line": 47}, "expected": {"at_head": "CLEAN"}, "fact": "`just check-isolation` resolves to a justfile recipe, not a file.", "trap": "same trap as N01 through a less common runner -- covers R1 hard-coding only make/npm.", "confirm": []}
{"id": "R1C-N03", "class": "control", "subclass": "near-miss/gitignored-but-present", "repo": "patrick-motard/dotfiles", "clone": "https://github.com/patrick-motard/dotfiles.git", "config": "CLAUDE.md", "referent": "dot_zsh/dot_zprofile.tmpl", "head": "a18fff6b8621c533ce58899be374d63cbbf09140", "declaration": {"line": 146}, "expected": {"at_head": "CLEAN"}, "fact": "the referent is absent from the tree AND listed in .gitignore:43. The commit that removed it says so: 'Move dot_zsh/.zprofile to private dotfiles; gitignore and chezmoiignore it'.", "trap": "the file is present on the developer's disk and deliberately untracked. A tree-only existence check reports drift that is not drift.", "confirm": [{"cmd": "git ls-tree a18fff6b8621c533ce58899be374d63cbbf09140 -- dot_zsh/dot_zprofile.tmpl", "exit": 0, "stdout": "", "stderr": ""}]}
{"id": "R1C-N04", "class": "control", "subclass": "near-miss/temporal", "repo": "wst7/tam", "clone": "https://github.com/wst7/tam.git", "config": "AGENTS.md", "referent": ".github/workflows/release.yml", "head": "d395841288bbf86960a931924ff628c5b264d066", "declaration": {"line": 81}, "expected": {"at_head": "CLEAN"}, "fact": "the rule '.github/workflows/release.yml is auto-generated by cargo-dist. Do not edit manually' landed 2026-05-22. The path has 29 commits, the most recent 2025-08-04 -- every edit PREDATES the rule by 9+ months.", "trap": "a detector that reads 'do not edit X' and asks 'has X been edited?' fires. The rule has never been violated.", "confirm": [{"cmd": "git ls-tree d395841288bbf86960a931924ff628c5b264d066 -- .github/workflows/release.yml", "exit": 0, "stdout": "100644 blob be2db4e131156f9fabb4c02ad32e30cb87960eac\t.github/workflows/release.yml", "stderr": ""}, {"cmd": "git log -1 --format=%cI -- .github/workflows/release.yml", "exit": 0, "stdout": "2025-08-04T09:53:29+08:00", "stderr": ""}, {"cmd": "git rev-list --count d395841288bbf86960a931924ff628c5b264d066 -- .github/workflows/release.yml", "exit": 0, "stdout": "29", "stderr": ""}]}
{"id": "R1C-N05", "class": "control", "subclass": "near-miss/temporal", "repo": "sjucker/referee-coach", "clone": "https://github.com/sjucker/referee-coach.git", "config": "CLAUDE.md", "referent": "src/main/webapp/app/rest.ts", "head": "7880c49ab9932e11dbe941bdb44eca27b48f99d1", "declaration": {"line": 65}, "expected": {"at_head": "CLEAN"}, "fact": "auto-generated file rule landed 2026-05-22; the path's 30 edits all predate it (most recent 2026-01-09).", "trap": "second instance of the temporal trap, different generator toolchain.", "confirm": [{"cmd": "git ls-tree 7880c49ab9932e11dbe941bdb44eca27b48f99d1 -- src/main/webapp/app/rest.ts", "exit": 0, "stdout": "100644 blob ce4079a35ef514b32e028e019ebef4bcfeec2d57\tsrc/main/webapp/app/rest.ts", "stderr": ""}, {"cmd": "git log -1 --format=%cI -- src/main/webapp/app/rest.ts", "exit": 0, "stdout": "2026-01-09T23:19:06+01:00", "stderr": ""}, {"cmd": "git rev-list --count 7880c49ab9932e11dbe941bdb44eca27b48f99d1 -- src/main/webapp/app/rest.ts", "exit": 0, "stdout": "30", "stderr": ""}]}
{"id": "R1C-N06", "class": "control", "subclass": "near-miss/prose-mention", "repo": "hyldmo/spotify-organizer", "clone": "https://github.com/hyldmo/spotify-organizer.git", "config": "CLAUDE.md", "referent": "webpack", "head": "e3877d00f48bb50af42f131c857297f1855ca377", "declaration": {"line": 12}, "expected": {"at_head": "CLEAN"}, "fact": "line 12 reads '**Build:** Vite 6 (migrated from webpack in commit `bb4fd8b`)'. `webpack` is named as the tool that was REPLACED, and `bb4fd8b` is a commit SHA in backticks.", "trap": "neither token is a declaration. A detector treating every backticked token as an assertion reports two findings, both wrong.", "confirm": []}
{"id": "R1C-N07", "class": "control", "subclass": "near-miss/prose-mention", "repo": "Andrew-Hird/rav4cool", "clone": "https://github.com/Andrew-Hird/rav4cool.git", "config": "CLAUDE.md", "referent": "npm", "head": "a23064a70945e3f5c8d365dbcdef258ae6afec2b", "declaration": {"line": 168}, "expected": {"at_head": "CLEAN"}, "fact": "line 168 reads '**Do not use `npm` or `npx`** -- use `bun` for all package/script operations'.", "trap": "`npm` is named as a PROHIBITION. Its absence is the intended state; its presence would be the violation. Polarity is inverted vs a declaration.", "confirm": []}
{"id": "R1C-N08", "class": "control", "subclass": "near-miss/declared-as-deleted", "repo": "webpractik/nextjs-starter", "clone": "https://github.com/webpractik/nextjs-starter.git", "config": "AGENTS.md", "referent": "bunfig.toml", "head": "9c93e1e22fa9e48035a4994a8b784d7fd2e42651", "declaration": {"line": 20}, "expected": {"at_head": "CLEAN"}, "fact": "line 20 reads '`bun.lock` and `bunfig.toml` were removed in the migration; do not restore them' (ru). The referent is genuinely absent.", "trap": "the config declares the referent's ABSENCE as correct. Flagging it inverts the author's intent -- found by mining, not designed.", "confirm": [{"cmd": "git ls-tree 9c93e1e22fa9e48035a4994a8b784d7fd2e42651 -- bunfig.toml", "exit": 0, "stdout": "", "stderr": ""}]}
